NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
NEXT_PUBLIC_SITE_URL=https://webfitnews.co.nz
# Server only. Never expose this key with a NEXT_PUBLIC_ prefix.
STRIPE_SECRET_KEY=your_stripe_secret_key_here
# Server only. Used by /api/world/weather. Never expose this key client-side.
OPENWEATHER_API_KEY=your_openweather_api_key_here
# Server only. Optional until an approved NZBN API subscription is provisioned.
# Used by /api/scam-check for live public NZBN registry lookups.
NZBN_API_KEY=your_nzbn_api_subscription_key_here

# Volunteer agreement uses the existing RESEND_API_KEY and optional NEWSROOM_EMAIL_FROM.
# Override only with a verified newsroom inbox authorised to receive signed agreements.
VOLUNTEER_NDA_INBOX=webfitnews@gmail.com
# Use a server-side Resend key with sending access for the verified sender domain.
# RESEND_API_KEY=
# Optional sender override. The existing default is newsroom@webfitnews.com.
# NEWSROOM_EMAIL_FROM=Webfit Newsroom <newsroom@webfitnews.com>
