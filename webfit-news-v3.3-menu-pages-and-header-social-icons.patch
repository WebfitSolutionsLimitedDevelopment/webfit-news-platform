+import styles from './HeaderSocialLinks.module.css';
+
+type Props={social:Record<string,string>};
+
+function FacebookIcon(){return <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.2 8.1h2.6V4.3c-.4-.1-1.9-.2-3.6-.2-3.5 0-5.9 2.1-5.9 6v3.4H3.4v4.3h3.9V24h4.8v-6.2h4l.6-4.3h-4.6v-3c0-1.2.3-2.4 2.1-2.4Z"/></svg>}
+function InstagramIcon(){return <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7.1 2h9.8A5.1 5.1 0 0 1 22 7.1v9.8a5.1 5.1 0 0 1-5.1 5.1H7.1A5.1 5.1 0 0 1 2 16.9V7.1A5.1 5.1 0 0 1 7.1 2Zm-.2 2A2.9 2.9 0 0 0 4 6.9v10.2A2.9 2.9 0 0 0 6.9 20h10.2a2.9 2.9 0 0 0 2.9-2.9V6.9A2.9 2.9 0 0 0 17.1 4H6.9Zm10.7 1.5a1.2 1.2 0 1 1 0 2.4 1.2 1.2 0 0 1 0-2.4ZM12 6.8A5.2 5.2 0 1 1 12 17.2 5.2 5.2 0 0 1 12 6.8Zm0 2A3.2 3.2 0 1 0 12 15.2 3.2 3.2 0 0 0 12 8.8Z"/></svg>}
+function YouTubeIcon(){return <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8ZM9.6 15.6V8.4L15.8 12l-6.2 3.6Z"/></svg>}
+function LinkedInIcon(){return <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5.3 7.9H.8V22h4.5V7.9ZM3.1 1A2.6 2.6 0 1 0 3.1 6.2 2.6 2.6 0 0 0 3.1 1ZM22.9 13.9c0-4.2-2.2-6.2-5.2-6.2a4.5 4.5 0 0 0-4.1 2.3V7.9H9.1V22h4.5v-7c0-1.8.3-3.6 2.6-3.6 2.2 0 2.3 2.1 2.3 3.7V22H23l-.1-8.1Z"/></svg>}
+
+export function HeaderSocialLinks({social}:Props){
+  const facebook=social.facebook_page||social.facebook||social.facebook_profile;
+  const items=[
+    facebook?{label:'Facebook',href:facebook,icon:<FacebookIcon/>}:null,
+    social.instagram?{label:'Instagram',href:social.instagram,icon:<InstagramIcon/>}:null,
+    social.youtube?{label:'YouTube',href:social.youtube,icon:<YouTubeIcon/>}:null,
+    social.linkedin?{label:'LinkedIn',href:social.linkedin,icon:<LinkedInIcon/>}:null,
+  ].filter(Boolean) as Array<{label:string;href:string;icon:React.ReactNode}>;
+
+  if(!items.length)return null;
+
+  return <div className={styles.social} aria-label="Follow Webfit News">
+    {items.map(item=><a key={item.label} href={item.href} target="_blank" rel="noopener noreferrer" aria-label={item.label} title={item.label}>{item.icon}</a>)}
+  </div>;
+}
