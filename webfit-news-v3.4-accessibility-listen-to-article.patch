+.controls button:hover:not(:disabled){
+  border-color:#0b1821;
+}
+.controls button:disabled{
+  opacity:.45;
+  cursor:default;
+}
+.controls .primary{
+  background:#0b1821;
+  color:#fff;
+  border-color:#0b1821;
+}
+.speed{
+  display:flex;
+  align-items:center;
+  gap:6px;
+  padding-left:3px;
+  font-size:11px;
+  font-weight:800;
+  color:#555;
