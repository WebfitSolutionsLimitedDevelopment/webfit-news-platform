+  [class*="ArticleWorkspace_field"] input,
+  [class*="ArticleWorkspace_field"] textarea,
+  [class*="ArticleWorkspace_field"] select,
+  [class*="ArticleWorkspace_categoryBox"]>input{
+    min-height:46px!important;
+    padding:11px!important;
+    font-size:16px!important;
+    border-radius:8px!important;
+  }
